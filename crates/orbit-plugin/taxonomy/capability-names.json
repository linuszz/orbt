{
  "$schema": "internal/orbit-capability-names-v1",
  "version": 1,
  "last_updated": "2026-10-07",
  "description": "Orbit Plugin Capability 白名单。每个 capability 必须对应 [00-orbit-baseline §11](../../00-orbit-baseline.md#11-capability--基线子系统映射) 中的 orbitd 子系统。",
  "capabilities": {
    "perceive.pane-output": {
      "verb": "perceive",
      "domain": "pane-output",
      "subsystem": "orbit_io::pty::on_output",
      "enabled_hook": "pane.output",
      "allowed_scopes": [
        "pane_id",
        "pane_kind",
        "agent_kind",
        "phase"
      ],
      "default_scope": {
        "phase": "self"
      },
      "default_scope_rationale": "REV-2026-10-07 决策 #8：读侧对称默认 self，避免 Session 级 Plugin 默认读全部 Pane 字节流",
      "description": "感知 PTY 原始字节流"
    },
    "perceive.pane-output-match": {
      "verb": "perceive",
      "domain": "pane-output-match",
      "subsystem": "orbit_io::pty::on_output + orbit_plugin::pattern_index",
      "enabled_hook": "pane.output.match",
      "allowed_scopes": [
        "pane_id",
        "pattern_id",
        "phase"
      ],
      "default_scope": {
        "pane_id": "self"
      },
      "description": "感知 Pane 输出的 pattern 匹配边沿事件"
    },
    "perceive.pane-exit": {
      "verb": "perceive",
      "domain": "pane-exit",
